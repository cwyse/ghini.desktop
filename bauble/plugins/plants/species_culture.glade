<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkListStore" id="species_culture_store">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkScrolledWindow" id="species_culture_scrolledwindow">
    <property name="visible">True</property>
    <property name="can_focus">True</property>
    <property name="hscrollbar_policy">automatic</property>
    <property name="vscrollbar_policy">automatic</property>
    <child>
      <object class="GtkTreeView" id="species_culture_treeview">
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="model">species_culture_store</property>
        <property name="headers_visible">True</property>
        <child internal-child="selection">
          <object class="GtkTreeSelection"/>
        </child>
        <child>
          <object class="GtkTreeViewColumn" id="species_culture_category_column">
            <property name="title" translatable="yes">Category</property>
            <child>
              <object class="GtkCellRendererText" id="species_culture_category_cell"/>
              <attributes>
                <attribute name="text">0</attribute>
              </attributes>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkTreeViewColumn" id="species_culture_item_column">
            <property name="title" translatable="yes">Item</property>
            <child>
              <object class="GtkCellRendererText" id="species_culture_item_cell"/>
              <attributes>
                <attribute name="text">1</attribute>
              </attributes>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkTreeViewColumn" id="species_culture_value_column">
            <property name="title" translatable="yes">Value</property>
            <child>
              <object class="GtkCellRendererText" id="species_culture_value_cell">
                <property name="wrap_mode">word-char</property>
                <property name="wrap_width">520</property>
              </object>
              <attributes>
                <attribute name="text">2</attribute>
              </attributes>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
